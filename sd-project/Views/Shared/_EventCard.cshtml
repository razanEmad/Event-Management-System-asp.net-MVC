@model EventBooking.Models.Event

<div class="card h-100 bg-card border-glass shadow-sm event-card hover-lift overflow-hidden">
    <div class="position-relative">
        <img src="@Model.ImageUrl" alt="@Model.Title" class="card-img-top object-fit-cover" style="height: 200px;" />
        
        <!-- Badges -->
        <div class="position-absolute top-0 start-0 m-2 d-flex flex-column gap-2">
            @if (Model.Category != null)
            {
                <span class="badge bg-dark border border-secondary rounded-pill shadow-sm py-1 px-2">
                    <i class="bi @Model.Category.Icon me-1"></i> @Model.Category.Name
                </span>
            }
            @if (Model.IsFeatured)
            {
                <span class="badge bg-warning text-dark rounded-pill shadow-sm py-1 px-2 fw-bold">
                    <i class="bi bi-star-fill me-1"></i> Featured
                </span>
            }
        </div>

        <!-- Price Badge -->
        <div class="position-absolute bottom-0 end-0 m-2">
            <span class="badge bg-primary text-white fs-6 rounded-pill shadow-sm py-2 px-3 fw-bold">
                @(Model.Price == 0 ? "FREE" : $"${Model.Price.ToString("0.00")}")
            </span>
        </div>
    </div>
    
    <div class="card-body d-flex flex-column p-4">
        <h5 class="card-title fw-bold text-light mb-3 text-truncate" title="@Model.Title">@Model.Title</h5>
        
        <div class="mb-3 text-secondary small d-flex flex-column gap-2">
            <div><i class="bi bi-calendar3 text-primary me-2"></i> @Model.Date.ToString("ddd, MMM dd, yyyy")</div>
            <div><i class="bi bi-clock text-primary me-2"></i> @Model.Date.ToString("hh:mm tt")</div>
            <div class="text-truncate" title="@Model.Location, @Model.City"><i class="bi bi-geo-alt text-primary me-2"></i> @Model.City</div>
        </div>
        
        <div class="mt-auto pt-3 border-top border-glass d-flex justify-content-between align-items-center">
            <div>
                @if (Model.AvailableTickets <= 0)
                {
                    <span class="text-danger fw-bold small"><i class="bi bi-x-circle me-1"></i> Sold Out</span>
                }
                else if (Model.AvailableTickets < 20)
                {
                    <span class="text-warning fw-semibold small"><i class="bi bi-exclamation-triangle me-1"></i> Only @Model.AvailableTickets left</span>
                }
                else
                {
                    <span class="text-success small"><i class="bi bi-check-circle me-1"></i> Tickets Available</span>
                }
            </div>
            
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                Details
            </a>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        border-color: var(--bs-primary) !important;
    }
</style>

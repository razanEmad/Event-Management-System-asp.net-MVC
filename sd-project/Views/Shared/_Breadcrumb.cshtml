@model Dictionary<string, string>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        @foreach (var item in Model)
        {
            var isLast = item.Key == Model.Last().Key;
            
            if (isLast)
            {
                <li class="breadcrumb-item active text-light" aria-current="page">@item.Key</li>
            }
            else
            {
                <li class="breadcrumb-item">
                    <a href="@item.Value" class="text-secondary text-decoration-none hover-primary">@item.Key</a>
                </li>
            }
        }
    </ol>
</nav>

<style>
    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
        color: #6B6B8D;
        font-size: 1.2rem;
        line-height: 1;
        vertical-align: middle;
    }
    .hover-primary:hover {
        color: var(--bs-primary) !important;
    }
</style>

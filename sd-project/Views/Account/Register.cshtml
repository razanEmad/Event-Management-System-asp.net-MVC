@model EventBooking.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-section py-5 mt-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="auth-card p-4 p-md-5 bg-card border border-glass rounded-4 shadow-lg">
                    <div class="text-center mb-4">
                        <div class="auth-icon-wrapper mb-3 d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-plus fs-2"></i>
                        </div>
                        <h2 class="fw-bold">Create an Account</h2>
                        <p class="text-secondary">Join us to start booking amazing events</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                                    <label asp-for="FullName"><i class="bi bi-person me-1"></i> Full Name</label>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="City" class="form-control" placeholder="City" />
                                    <label asp-for="City"><i class="bi bi-geo-alt me-1"></i> City (Optional)</label>
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <label asp-for="Email"><i class="bi bi-envelope me-1"></i> Email address</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="Password" class="form-control" placeholder="Password" />
                                    <label asp-for="Password"><i class="bi bi-lock me-1"></i> Password</label>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                                    <label asp-for="ConfirmPassword"><i class="bi bi-lock-fill me-1"></i> Confirm Password</label>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-hero-primary w-100 py-2 mb-3">
                            Register Account
                        </button>
                    </form>

                    <div class="text-center text-secondary">
                        Already have an account? <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Login here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

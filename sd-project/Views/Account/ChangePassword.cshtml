@model EventBooking.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<section class="profile-section py-5 mt-5">
    <div class="container">
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="list-group list-group-flush rounded-3 shadow-sm">
                    <a asp-action="Profile" class="list-group-item list-group-item-action bg-card text-light border-glass">
                        <i class="bi bi-person me-2"></i> Edit Profile
                    </a>
                    <a asp-action="ChangePassword" class="list-group-item list-group-item-action active bg-primary border-primary text-white">
                        <i class="bi bi-key me-2"></i> Change Password
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action bg-card text-light border-glass">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </div>
            </div>
            
            <div class="col-md-9">
                <div class="card bg-card border-glass shadow-sm">
                    <div class="card-header bg-transparent border-glass">
                        <h4 class="mb-0 fw-bold">Change Password</h4>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="ChangePassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                            
                            <div class="mb-3">
                                <label asp-for="CurrentPassword" class="form-label text-secondary"></label>
                                <input asp-for="CurrentPassword" class="form-control bg-surface border-glass text-light" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label text-secondary"></label>
                                <input asp-for="NewPassword" class="form-control bg-surface border-glass text-light" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label text-secondary"></label>
                                <input asp-for="ConfirmPassword" class="form-control bg-surface border-glass text-light" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            
                            <button type="submit" class="btn btn-primary px-4">Update Password</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

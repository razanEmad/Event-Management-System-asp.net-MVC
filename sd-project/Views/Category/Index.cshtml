@model List<EventBooking.Models.Category>
@{
    ViewData["Title"] = "Event Categories";
}

<!-- ===== Page Header ===== -->
<section class="page-header py-5 bg-surface mt-5 border-bottom border-glass">
    <div class="container text-center py-4">
        <h1 class="page-title fw-bold display-5 mb-3">
            <span class="text-primary"><i class="bi bi-grid me-2"></i></span> Explore Categories
        </h1>
        <p class="page-subtitle text-secondary fs-5 max-w-2xl mx-auto">Find exactly what you're looking for by browsing our curated event categories.</p>
    </div>
</section>

<!-- ===== Categories Grid ===== -->
<section class="categories-section py-5">
    <div class="container">
        <div class="row g-4">
            @foreach (var category in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <a asp-action="Details" asp-route-slug="@category.Slug" class="text-decoration-none">
                        <div class="card h-100 bg-card border-glass shadow-sm category-card transition-all hover-lift">
                            <div class="card-body text-center p-4">
                                <div class="category-icon-wrapper mb-3 mx-auto d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle" style="width: 70px; height: 70px;">
                                    <i class="bi @category.Icon fs-1"></i>
                                </div>
                                <h5 class="card-title fw-bold text-light mb-2">@category.Name</h5>
                                <p class="card-text text-secondary small mb-3 line-clamp-2">@category.Description</p>
                                <span class="badge bg-surface text-primary border border-primary-subtle rounded-pill px-3 py-2">
                                    @category.Events.Count(e => e.Date >= DateTime.Now) upcoming
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
        border-color: var(--bs-primary) !important;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

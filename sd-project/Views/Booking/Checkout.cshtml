@model EventBooking.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<section class="checkout-section py-5 mt-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="card bg-card border-glass shadow-lg rounded-4 mb-4">
                    <div class="card-header bg-transparent border-glass p-4 pb-0">
                        <h3 class="fw-bold mb-0">Secure Checkout</h3>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="ProcessPayment" asp-route-bookingId="@Model.Booking.Id" method="post" id="payment-form">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <h5 class="fw-bold mb-3"><i class="bi bi-credit-card me-2 text-primary"></i>Payment Details</h5>

                            <div class="mb-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="PaymentMethod" id="method-cc" value="CreditCard" autocomplete="off" checked>
                                    <label class="btn btn-outline-primary py-3" for="method-cc">
                                        <i class="bi bi-credit-card fs-4 d-block mb-1"></i> Credit Card
                                    </label>

                                    <input type="radio" class="btn-check" name="PaymentMethod" id="method-paypal" value="PayPal" autocomplete="off">
                                    <label class="btn btn-outline-primary py-3" for="method-paypal">
                                        <i class="bi bi-paypal fs-4 d-block mb-1"></i> PayPal
                                    </label>
                                </div>
                            </div>

                            <div id="credit-card-details">
                                <div class="form-floating mb-3">
                                    <input asp-for="CardholderName" class="form-control bg-surface border-glass text-light" placeholder="John Doe" />
                                    <label asp-for="CardholderName" class="text-secondary">Name on Card</label>
                                    <span asp-validation-for="CardholderName" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="CardNumber" class="form-control bg-surface border-glass text-light" placeholder="0000 0000 0000 0000" />
                                    <label asp-for="CardNumber" class="text-secondary">Card Number</label>
                                    <span asp-validation-for="CardNumber" class="text-danger small"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <div class="form-floating">
                                            <input asp-for="ExpiryDate" class="form-control bg-surface border-glass text-light" placeholder="MM/YY" />
                                            <label asp-for="ExpiryDate" class="text-secondary">Expiry Date (MM/YY)</label>
                                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="form-floating">
                                            <input asp-for="CVV" class="form-control bg-surface border-glass text-light" placeholder="123" />
                                            <label asp-for="CVV" class="text-secondary">CVV</label>
                                            <span asp-validation-for="CVV" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold fs-5 shadow-sm">
                                Pay $@Model.TotalAmount.ToString("0.00")
                            </button>
                            <p class="text-center text-secondary small mt-3 mb-0">
                                <i class="bi bi-shield-lock text-success me-1"></i> Your payment information is encrypted and secure.
                            </p>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card bg-surface border-glass shadow-sm rounded-4 position-sticky" style="top: 100px;">
                    <div class="card-header bg-transparent border-glass p-4 pb-0">
                        <h5 class="fw-bold mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex mb-4">
                            <img src="@Model.Event.ImageUrl" alt="@Model.Event.Title" class="rounded-3 me-3 object-fit-cover" style="width: 80px; height: 80px;" />
                            <div>
                                <h6 class="fw-bold text-light mb-1 line-clamp-2">@Model.Event.Title</h6>
                                <p class="text-secondary small mb-0">
                                    <i class="bi bi-calendar3 me-1"></i> @Model.Event.Date.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        </div>

                        <hr class="border-glass mb-4" />

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Ticket Type</span>
                            <span class="text-light fw-medium">@Model.TicketType.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Price per ticket</span>
                            <span class="text-light fw-medium">$@Model.TicketType.Price.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-secondary">Quantity</span>
                            <span class="text-light fw-medium">x @Model.Booking.TicketCount</span>
                        </div>

                        <hr class="border-glass mb-4" />

                        <div class="d-flex justify-content-between align-items-center mb-0">
                            <span class="fw-bold fs-5 text-light">Total</span>
                            <span class="fw-bold fs-3 text-primary">$@Model.TotalAmount.ToString("0.00")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('input[name="PaymentMethod"]').change(function () {
                if ($(this).val() === 'PayPal') {
                    $('#credit-card-details').slideUp();
                } else {
                    $('#credit-card-details').slideDown();
                }
            });
        });
    </script>
}

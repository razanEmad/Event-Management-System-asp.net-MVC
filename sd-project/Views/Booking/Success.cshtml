@model EventBooking.Models.Booking
@{
    ViewData["Title"] = "Booking Confirmed!";
}

<section class="success-section py-5 mt-5 min-vh-75 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card bg-card border-glass shadow-lg rounded-4 overflow-hidden">
                    <div class="bg-success py-4 text-center">
                        <i class="bi bi-check-circle-fill text-white display-1" style="animation: scaleIn 0.5s ease;"></i>
                        <h2 class="text-white fw-bold mt-3 mb-0">Booking Confirmed!</h2>
                    </div>
                    
                    <div class="card-body p-4 p-md-5">
                        <p class="text-center text-secondary mb-4 fs-5">Thank you, <strong>@Model.CustomerName</strong>. Your tickets are secured.</p>
                        
                        <div class="bg-surface border border-glass rounded-3 p-4 mb-4">
                            <div class="d-flex justify-content-between border-bottom border-glass pb-3 mb-3">
                                <span class="text-secondary small text-uppercase fw-bold">Order Number</span>
                                <span class="text-primary fw-mono fw-bold">@(Model.Order?.OrderNumber ?? $"ORD-{Model.Id:D6}")</span>
                            </div>
                            
                            <h5 class="fw-bold text-light mb-3">@Model.Event?.Title</h5>
                            
                            <div class="row g-3 mb-3 text-secondary small">
                                <div class="col-6">
                                    <i class="bi bi-calendar3 me-1 text-primary"></i> @Model.Event?.Date.ToString("MMM dd, yyyy")
                                </div>
                                <div class="col-6">
                                    <i class="bi bi-clock me-1 text-primary"></i> @Model.Event?.Date.ToString("hh:mm tt")
                                </div>
                                <div class="col-12">
                                    <i class="bi bi-geo-alt me-1 text-primary"></i> @Model.Event?.Location, @Model.Event?.City
                                </div>
                            </div>
                            
                            <hr class="border-glass mb-3" />
                            
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-light">@Model.TicketCount x @(Model.TicketType?.Name ?? "Standard") Ticket</span>
                                <span class="text-light fw-medium">$@Model.TotalPrice.ToString("0.00")</span>
                            </div>
                            
                            @if (Model.PaymentStatus == "Paid")
                            {
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-glass">
                                    <span class="badge bg-success">Paid</span>
                                    <span class="text-secondary small">via @(Model.Payment?.Method ?? "Credit Card")</span>
                                </div>
                            }
                        </div>
                        
                        <div class="text-center mb-4">
                            <p class="small text-secondary mb-0">A confirmation email has been sent to <strong>@Model.Email</strong>.</p>
                        </div>
                        
                        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold flex-grow-1">
                                    <i class="bi bi-speedometer2 me-2"></i> View Dashboard
                                </a>
                            }
                            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold flex-grow-1">
                                <i class="bi bi-calendar3 me-2"></i> Browse More
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @@keyframes scaleIn { 
        0% { transform: scale(0); opacity: 0; } 
        60% { transform: scale(1.1); } 
        100% { transform: scale(1); opacity: 1; } 
    }
    .fw-mono { font-family: 'Courier New', Courier, monospace; }
</style>

@model EventBooking.Models.ViewModels.AdminEventViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<section class="admin-section py-5 mt-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Edit Event</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb m-0 small">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">Admin</a></li>
                        <li class="breadcrumb-item"><a asp-action="Events" class="text-secondary text-decoration-none">Events</a></li>
                        <li class="breadcrumb-item active text-light" aria-current="page">@Model.Title</li>
                    </ol>
                </nav>
            </div>
            <a asp-action="Events" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
        </div>

        <div class="card bg-card border-glass shadow-sm mb-5">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="EditEvent" asp-route-id="@Model.Id" method="post" id="eventForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Include the exact same form fields as CreateEvent.cshtml -->
                    <!-- For brevity, copying the basic info section -->
                    
                    <h4 class="fw-bold mb-4 text-primary border-bottom border-glass pb-2">1. Basic Information</h4>
                    
                    <div class="row g-4 mb-5">
                        <div class="col-md-8">
                            <div class="form-floating mb-3">
                                <input asp-for="Title" class="form-control bg-surface border-glass text-light" placeholder="Event Title" />
                                <label asp-for="Title" class="text-secondary">Event Title *</label>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating mb-3">
                                <select asp-for="CategoryId" class="form-select bg-surface border-glass text-light" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <label asp-for="CategoryId" class="text-secondary">Category *</label>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating mb-3">
                                <textarea asp-for="Description" class="form-control bg-surface border-glass text-light" placeholder="Description" style="height: 120px"></textarea>
                                <label asp-for="Description" class="text-secondary">Full Description *</label>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating mb-3">
                                <input asp-for="ImageUrl" class="form-control bg-surface border-glass text-light" placeholder="https://..." />
                                <label asp-for="ImageUrl" class="text-secondary">Cover Image URL</label>
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <h4 class="fw-bold mb-4 text-primary border-bottom border-glass pb-2">2. Schedule & Location</h4>
                    
                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="Date" class="form-control bg-surface border-glass text-light" type="datetime-local" />
                                <label asp-for="Date" class="text-secondary">Start Date & Time *</label>
                                <span asp-validation-for="Date" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="EndDate" class="form-control bg-surface border-glass text-light" type="datetime-local" />
                                <label asp-for="EndDate" class="text-secondary">End Date & Time</label>
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="Location" class="form-control bg-surface border-glass text-light" placeholder="Venue Name" />
                                <label asp-for="Location" class="text-secondary">Venue Name / Address *</label>
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="City" class="form-control bg-surface border-glass text-light" placeholder="City" />
                                <label asp-for="City" class="text-secondary">City *</label>
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="RecurrenceRule" class="form-control bg-surface border-glass text-light" placeholder="e.g., Every Tuesday" />
                                <label asp-for="RecurrenceRule" class="text-secondary">Recurrence Rule</label>
                                <span asp-validation-for="RecurrenceRule" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="IsFeatured" class="form-check-label text-light ms-2">Mark as Featured Event</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-glass pb-2">
                        <h4 class="fw-bold mb-0 text-primary">3. Ticket Types</h4>
                        <button type="button" id="addTicketType" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="bi bi-plus-lg me-1"></i> Add Ticket Type
                        </button>
                    </div>

                    <div id="ticketTypesContainer" class="mb-5">
                        @for (int i = 0; i < Model.TicketTypes.Count; i++)
                        {
                            <div class="ticket-type-row card bg-surface border-glass mb-3 shadow-sm position-relative">
                                @if (Model.TicketTypes.Count > 1)
                                {
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 rounded-circle remove-ticket" style="width: 28px; height: 28px; padding: 0; line-height: 1;">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                                <div class="card-body p-3 p-md-4">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label text-secondary small">Ticket Name *</label>
                                            <input name="TicketTypes[@i].Name" value="@Model.TicketTypes[i].Name" class="form-control bg-card border-glass text-light" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-secondary small">Price ($) *</label>
                                            <input name="TicketTypes[@i].Price" value="@Model.TicketTypes[i].Price.ToString("0.00")" type="number" step="0.01" min="0" class="form-control bg-card border-glass text-light" required />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label text-secondary small">Total Quantity *</label>
                                            <input name="TicketTypes[@i].Quantity" value="@Model.TicketTypes[i].Quantity" type="number" min="1" class="form-control bg-card border-glass text-light" required />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label text-secondary small">Description</label>
                                            <input name="TicketTypes[@i].Description" value="@Model.TicketTypes[i].Description" class="form-control bg-card border-glass text-light" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <hr class="border-glass my-5" />
                    
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-warning small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Changing ticket quantities may affect existing bookings.
                        </div>
                        <div class="d-flex gap-3">
                            <a asp-action="Events" class="btn btn-outline-light px-4 py-2 rounded-pill">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold">Save Changes</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            let ticketIndex = @Model.TicketTypes.Count;
            
            $('#addTicketType').click(function () {
                const template = `
                    <div class="ticket-type-row card bg-surface border-glass mb-3 shadow-sm position-relative" style="display: none;">
                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 rounded-circle remove-ticket" style="width: 28px; height: 28px; padding: 0; line-height: 1;">
                            <i class="bi bi-x"></i>
                        </button>
                        <div class="card-body p-3 p-md-4">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label text-secondary small">Ticket Name *</label>
                                    <input name="TicketTypes[${ticketIndex}].Name" class="form-control bg-card border-glass text-light" required placeholder="e.g., VIP, General" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-secondary small">Price ($) *</label>
                                    <input name="TicketTypes[${ticketIndex}].Price" type="number" step="0.01" min="0" value="0" class="form-control bg-card border-glass text-light" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label text-secondary small">Quantity *</label>
                                    <input name="TicketTypes[${ticketIndex}].Quantity" type="number" min="1" value="100" class="form-control bg-card border-glass text-light" required />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label text-secondary small">Description (Optional)</label>
                                    <input name="TicketTypes[${ticketIndex}].Description" class="form-control bg-card border-glass text-light" placeholder="What's included?" />
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                
                const $newRow = $(template);
                $('#ticketTypesContainer').append($newRow);
                $newRow.slideDown();
                ticketIndex++;
            });
            
            $(document).on('click', '.remove-ticket', function () {
                $(this).closest('.ticket-type-row').slideUp(function() {
                    $(this).remove();
                    
                    // Re-index remaining tickets
                    $('.ticket-type-row').each(function(index) {
                        $(this).find('input').each(function() {
                            const name = $(this).attr('name');
                            if(name) {
                                const newName = name.replace(/\[\d+\]/, `[${index}]`);
                                $(this).attr('name', newName);
                            }
                        });
                    });
                    ticketIndex = $('.ticket-type-row').length;
                });
            });
        });
    </script>
}

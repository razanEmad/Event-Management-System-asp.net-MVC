@model List<EventBooking.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
}

<section class="admin-section py-5 mt-5">
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Manage Users</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb m-0 small">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">Admin</a></li>
                        <li class="breadcrumb-item active text-light" aria-current="page">Users</li>
                    </ol>
                </nav>
            </div>
        </div>

        <div class="card bg-card border-glass shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4 py-3">User</th>
                                <th class="py-3">Email</th>
                                <th class="py-3">City</th>
                                <th class="py-3">Joined Date</th>
                                <th class="text-end pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 fw-bold fs-5" style="width: 40px; height: 40px;">
                                                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div class="fw-bold text-light">@user.FullName</div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-secondary">@user.Email</td>
                                    <td class="py-3 text-secondary">@(user.City ?? "N/A")</td>
                                    <td class="py-3 text-secondary">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4 py-3">
                                        <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info" title="View Profile">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @{
                                                var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.Now;
                                            }
                                            <button type="submit" class="btn btn-sm @(isLocked ? "btn-outline-success" : "btn-outline-warning") ms-1" title="@(isLocked ? "Enable User" : "Disable User")">
                                                <i class="bi @(isLocked ? "bi-check-circle" : "bi-slash-circle")"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

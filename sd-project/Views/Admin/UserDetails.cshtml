@model EventBooking.Models.ApplicationUser
@{
    ViewData["Title"] = "User Details";
    var isLocked = Model.LockoutEnd.HasValue && Model.LockoutEnd.Value > DateTimeOffset.Now;
}

<section class="admin-section py-5 mt-5">
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">User Details</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb m-0 small">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">Admin</a></li>
                        <li class="breadcrumb-item"><a asp-action="Users" class="text-secondary text-decoration-none">Users</a></li>
                        <li class="breadcrumb-item active text-light" aria-current="page">@Model.FullName</li>
                    </ol>
                </nav>
            </div>
            <div>
                <form asp-action="ToggleUserStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn @(isLocked ? "btn-success" : "btn-warning") shadow-sm" title="@(isLocked ? "Enable User" : "Disable User")">
                        <i class="bi @(isLocked ? "bi-check-circle" : "bi-slash-circle") me-2"></i>@(isLocked ? "Enable User" : "Disable User")
                    </button>
                </form>
            </div>
        </div>

        <div class="row g-4">
            <!-- User Info Card -->
            <div class="col-md-4">
                <div class="card bg-card border-glass shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 text-center">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3 fw-bold display-4 shadow-sm" style="width: 100px; height: 100px;">
                            @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                        </div>
                        <h4 class="fw-bold text-light mb-1">@Model.FullName</h4>
                        <p class="text-secondary mb-3">@Model.Email</p>
                        
                        <div class="d-flex justify-content-center mb-4">
                            @if (isLocked)
                            {
                                <span class="badge bg-danger text-white px-3 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i> Disabled</span>
                            }
                            else
                            {
                                <span class="badge bg-success text-white px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i> Active</span>
                            }
                        </div>

                        <hr class="border-glass my-3" />
                        
                        <div class="text-start">
                            <p class="text-secondary mb-2"><i class="bi bi-geo-alt me-2 text-primary"></i> <span class="text-light">@(Model.City ?? "Not specified")</span></p>
                            <p class="text-secondary mb-2"><i class="bi bi-calendar3 me-2 text-primary"></i> Joined <span class="text-light">@Model.CreatedAt.ToString("MMM dd, yyyy")</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Booking History -->
            <div class="col-md-8">
                <div class="card bg-card border-glass shadow-sm rounded-4 h-100">
                    <div class="card-header bg-transparent border-glass p-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-ticket-perforated text-primary me-2"></i> Booking History</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.Bookings != null && Model.Bookings.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-hover mb-0 align-middle">
                                    <thead>
                                        <tr>
                                            <th class="py-3">Event</th>
                                            <th class="py-3">Date</th>
                                            <th class="py-3 text-center">Tickets</th>
                                            <th class="py-3 text-end">Total</th>
                                            <th class="py-3 text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var booking in Model.Bookings.OrderByDescending(b => b.BookingDate))
                                        {
                                            <tr>
                                                <td class="py-3">
                                                    <div class="fw-bold text-light">@booking.Event?.Title</div>
                                                    <div class="small text-secondary">@booking.BookingDate.ToString("MMM dd, yyyy")</div>
                                                </td>
                                                <td class="py-3 text-secondary">@(booking.Event?.Date.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                                <td class="py-3 text-center text-light fw-medium">@booking.TicketCount</td>
                                                <td class="py-3 text-end text-light fw-medium">$@booking.TotalPrice.ToString("0.00")</td>
                                                <td class="py-3 text-center">
                                                    @if (booking.Status == "Confirmed")
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1">Confirmed</span>
                                                    }
                                                    else if (booking.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-2 py-1">Pending</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-2 py-1">@booking.Status</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-calendar-x text-secondary opacity-50 display-1 mb-3 d-block"></i>
                                <h5 class="text-secondary fw-medium">No bookings found</h5>
                                <p class="text-secondary small">This user hasn't booked any events yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
